{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "bun scripts/build-window-chrome.ts && bun run dev",
    "beforeBuildCommand": "bun scripts/build-window-chrome.ts --bundle-runtime && bun run build"
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "resources": {
      "target/window-chrome/": "window-chrome/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
