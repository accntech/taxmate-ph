{
  "name": "@pcsti/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "svelte": "./src/components/*/index.ts",
      "types": "./src/components/*/index.ts",
      "default": "./src/components/*/index.ts"
    },
    "./body-scroll-lock": {
      "types": "./src/utils/body-scroll-lock.ts",
      "default": "./src/utils/body-scroll-lock.ts"
    },
    "./avatar-helpers": {
      "types": "./src/components/avatar/helpers.ts",
      "default": "./src/components/avatar/helpers.ts"
    },
    "./dialog-controls-helpers": {
      "types": "./src/utils/dialog-controls-helpers.ts",
      "default": "./src/utils/dialog-controls-helpers.ts"
    },
    "./dialog-controls.svelte": {
      "types": "./src/utils/dialog-controls.svelte.ts",
      "default": "./src/utils/dialog-controls.svelte.ts"
    },
    "./date-input/date-helpers": {
      "types": "./src/components/date-input/date-helpers.ts",
      "default": "./src/components/date-input/date-helpers.ts"
    },
    "./date-range-filter/date-presets": {
      "types": "./src/components/date-range-filter/date-presets.ts",
      "default": "./src/components/date-range-filter/date-presets.ts"
    },
    "./keyboard-list": {
      "types": "./src/utils/keyboard-list.ts",
      "default": "./src/utils/keyboard-list.ts"
    },
    "./trigger-visibility": {
      "types": "./src/utils/trigger-visibility.ts",
      "default": "./src/utils/trigger-visibility.ts"
    },
    "./popover-motion": {
      "types": "./src/utils/popover-motion.ts",
      "default": "./src/utils/popover-motion.ts"
    },
    "./segment-focus": {
      "types": "./src/utils/segment-focus.ts",
      "default": "./src/utils/segment-focus.ts"
    },
    "./package.json": "./package.json",
    "./theme.stylex": {
      "types": "./src/theme.stylex.ts",
      "default": "./src/theme.stylex.ts"
    },
    "./styles/scales.css": "./src/styles/scales.css",
    "./style-attributes": {
      "types": "./src/styles/style-attributes.ts",
      "default": "./src/styles/style-attributes.ts"
    },
    "./styles/reset.css": "./src/styles/reset.css",
    "./glyphs": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    }
  },
  "dependencies": {
    "@solar-icons/svelte": "2.3.3",
    "@stylexjs/stylex": "^0.19.1",
    "@tanstack/svelte-virtual": "^3.13.36",
    "cropperjs": "^2.2.0",
    "formsnap": "^2.1.0",
    "fuzzysort": "^4.0.2",
    "mode-watcher": "^1.1.0",
    "sveltekit-superforms": "^2.30.2"
  },
  "peerDependencies": {
    "svelte": "^5.55.9"
  },
  "description": "Reusable PCSTI UI components vendored for TaxMate PH"
}
